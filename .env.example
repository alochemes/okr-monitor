# Copy to .env and fill in. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Mock mode ---
# DEV DEFAULT: "true" so smoke tests / accidental script runs don't burn credits.
# For an explicit real run from the CLI, prefix with the override:
#   OKR_MONITOR_DRY_RUN=false python scripts/run_ceo.py
# Cloud routines (Sunday, daily) set their own OKR_MONITOR_DRY_RUN=false.
OKR_MONITOR_DRY_RUN=true

# --- Operator ---
OPERATOR_EMAIL=alochemes@gmail.com

# --- Integrations ---
# GitHub: v0 ingestion uses a Personal Access Token (fine-grained PAT scoped
# to the target repos preferred). Required because the dogfood repo is
# private. Anonymous mode works for public repos but is rate-limited to
# 60 req/h. Sprint 1 swaps this for a GitHub App + webhook.
GITHUB_TOKEN=
# Comma-separated list of owner/repo pairs to poll on the daily run.
# Defaults to alochemes/okr-monitor when unset.
GITHUB_INGEST_REPOS=alochemes/okr-monitor

# Linear: personal API key from https://linear.app/<workspace>/settings/api
LINEAR_API_KEY=

# Reserved for future integrations (not yet wired).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
SLACK_BOT_TOKEN=

# Notion — canonical source for OKRs. See INSTRUCTIONS.md for the full
# walkthrough. NOTION_PARENT_PAGE_ID is the page that will host the OKR
# database (you create it in Notion, then connect the integration).
# NOTION_OKR_DATABASE_ID is filled in by `scripts/notion_okr_seed.py`.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_OKR_DATABASE_ID=

# --- Email (daily 7pm OWNER/FINANCE report) ---
# If SMTP_HOST is set, the daily report is emailed; otherwise it's only
# written to reports/daily/YYYY-MM-DD.md. Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<app-password, NOT your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alochemes@gmail.com
REPORT_TO_EMAIL=alochemes@gmail.com

# --- Web app (Vercel-served Next.js in web/) ---
# Set these in the Vercel dashboard for Production/Preview/Dev. Reproduced
# here so the dev workflow (web/.env.local) can mirror prod. NEXT_PUBLIC_
# prefix is required because the values are read in the browser.
# See web/DEPLOY.md for the full deploy walkthrough.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
