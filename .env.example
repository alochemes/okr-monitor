# Copy to .env and fill in. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Mock mode ---
# DEV DEFAULT: "true" so smoke tests / accidental script runs don't burn credits.
# For an explicit real run from the CLI, prefix with the override:
#   OKR_MONITOR_DRY_RUN=false python scripts/run_ceo.py
# Cloud routines (Sunday, daily) set their own OKR_MONITOR_DRY_RUN=false.
OKR_MONITOR_DRY_RUN=true

# --- Operator ---
OPERATOR_EMAIL=andrew@skinmap.com

# --- Integrations (Sprint 0 engineering, not yet wired) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
LINEAR_API_KEY=
SLACK_BOT_TOKEN=
NOTION_API_KEY=

# --- Email (daily 7pm OWNER/FINANCE report) ---
# If SMTP_HOST is set, the daily report is emailed; otherwise it's only
# written to reports/daily/YYYY-MM-DD.md. Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<app-password, NOT your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alochemes@gmail.com
REPORT_TO_EMAIL=alochemes@gmail.com
